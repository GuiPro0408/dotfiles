[color]
  branch = auto
  diff = auto
  interactive = auto
  status = auto
  ui = auto

[color "branch"]
  current = green
  remote = yellow

[core]
  pager = delta
  editor = code --wait
	excludesfile = /home/guillaume/.gitignore_global

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
  syntax-theme = Dracula

[interactive]
  diffFilter = delta --color-only

[diff]
  colorMoved = default

[merge]
  conflictstyle = zdiff3

[alias]
  co = checkout
  st = status -sb
  br = branch
  ci = commit
  fo = fetch origin
  d = !git --no-pager diff
  dt  = difftool
  stat = !git --no-pager diff --stat

  # Default branch: origin/HEAD, else local main, else master
  default-branch = "!b=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) && echo ${b#origin/} || { git show-ref -q --verify refs/heads/main && echo main || echo master; }"

  # Clean branches merged into the default branch
  sweep = "!b=$(git default-branch) && git branch --merged $b | grep -vE '^[*+]|^ *'$b'$' | xargs -r git branch -d && git remote prune origin"

  # http://www.jukie.net/bart/blog/pimping-out-git-log
  lg = log --graph --all --pretty=format:'%Cred%h%Creset - %s %Cgreen(%cr) %C(bold blue)%an%Creset %C(yellow)%d%Creset'

  # Serve local repo. http://coderwall.com/p/eybtga
  # Then other can access via `git clone git://#{YOUR_IP_ADDRESS}/
  serve = !git daemon --reuseaddr --verbose  --base-path=. --export-all ./.git

  m = "!git checkout $(git default-branch)"

  # Removes a file from the index
  unstage = reset HEAD --

  # Quick workflow aliases
  amend = commit --amend --no-edit
  undo = reset HEAD~1 --mixed
  wip = !git add -A && git commit -m 'WIP'
  last = log -1 HEAD --stat
  stash-all = stash push --include-untracked
  aliases = !git config --get-regexp ^alias\\\\. | sed -e s/^alias\\\\.// | sort

[help]
  autocorrect = prompt

[push]
	default = simple

[branch "master"]
  mergeoptions = --no-edit

[pull]
  rebase = false

[init]
	defaultBranch = main
